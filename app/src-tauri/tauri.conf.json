{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crucible",
  "mainBinaryName": "crucible-app",
  "version": "0.0.3",
  "identifier": "app.crucible",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crucible",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#0e1014"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "publisher": "Crucible",
    "category": "Music",
    "shortDescription": "Crucible, a small digital audio workstation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "wix": {
        "upgradeCode": "aa877f33-4a31-47a4-9892-5f4a6d3f2933",
        "language": "en-US",
        "template": "wix/main.wxs"
      }
    }
  }
}
